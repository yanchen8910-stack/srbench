FROM srbench/base AS build

ARG ALGORITHM
ENV ALGORITHM=$ALGORITHM
WORKDIR "/install"
COPY --chown=$MAMBA_USER:$MAMBA_USER base_environment.yml install_algorithm.sh .
COPY --chown=$MAMBA_USER:$MAMBA_USER ./algorithms/${ALGORITHM} ./${ALGORITHM}
ARG MAMBA_DOCKERFILE_ACTIVATE=1

RUN micromamba install -n base -y -c conda-forge boost-cpp=1.74.0 ninja cmake && \
    if test -f "./${ALGORITHM}/environment.yml"; then \
        grep -v "^name:" ./${ALGORITHM}/environment.yml > /tmp/alg_env.yml && \
        micromamba install -n base -y -f /tmp/alg_env.yml; \
    fi && \
    bash install_algorithm.sh ./${ALGORITHM} && \
    micromamba clean --all --yes

WORKDIR "/srbench"
USER root